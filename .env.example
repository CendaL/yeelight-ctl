# Copy this file to .env and fill in your values.
# .env is gitignored so your secrets never get committed.

# Your home WiFi, used by provision_wifi.py to onboard the bulb.
WIFI_SSID=your_wifi_name
WIFI_PASSWORD=your_wifi_password

# Only needed by provision_wifi.py, which talks to the bulb while it is in
# setup mode (broadcasting its own access point). Get this token from
# setup_bulb.py, which reads it during discovery.
# BULB_TOKEN=your_setup_mode_token
# BULB_AP_IP=192.168.4.1
